{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc --noEmit --project frontend/tsconfig.json && vite build --config frontend/vite.config.ts && vite build --config frontend/vite.global.config.ts",
    "typecheck": "tsc --noEmit --project frontend/tsconfig.json",
    "lint": "eslint --config frontend/eslint.config.ts frontend/src/ frontend/tests/",
    "lint:fix": "eslint --config frontend/eslint.config.ts frontend/src/ frontend/tests/ --fix",
    "lint:css": "stylelint \"blunder_tutor/web/static/css/**/*.css\"",
    "lint:css:fix": "stylelint \"blunder_tutor/web/static/css/**/*.css\" --fix",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:watch": "vitest --config frontend/vitest.config.ts",
    "test:coverage": "vitest run --config frontend/vitest.config.ts --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "stylelint": "^17.12.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@preact/signals": "^2.9.0",
    "@testing-library/dom": "^10.4.1",
    "preact": "^10.29.1"
  }
}
